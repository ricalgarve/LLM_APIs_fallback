# Ambientes Virtuais (Virtual Environments)
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Arquivos de Configuração com Chaves Sensíveis
config.json
.env

# Byte-compiled / cache do Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Caches e ferramentas de teste
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# IDEs e Editores
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# PyInstaller / Pastas de Compilação
build/
dist/
*.manifest

# Ignorar executáveis duplicados em subpastas de release para não inflar o Git
releases/*/*.exe

# Manter apenas o executável portátil principal na raiz de releases/
!releases/*.exe

# Arquivos de Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini
